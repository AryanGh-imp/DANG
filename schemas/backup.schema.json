{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DANG expense backup",
  "description": "Informative backup schema. Runtime validation additionally checks actual calendar dates, aggregate amounts, category uniqueness and merge behavior.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "v": { "enum": [1, 2, 3] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/expense" } },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "key": {
      "type": "string", "minLength": 1, "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": { "enum": ["__proto__", "constructor", "prototype"] }
    },
    "expense": {
      "type": "object", "required": ["date", "amt"],
      "properties": {
        "id": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "integer" }] },
        "date": { "type": "string", "format": "date", "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$" },
        "amt": { "type": "number", "minimum": 0.01, "maximum": 1000000000000, "multipleOf": 0.01 },
        "desc": { "type": "string", "maxLength": 10000 },
        "cat": { "$ref": "#/$defs/key" }
      }
    },
    "category": {
      "type": "object", "required": ["k"],
      "properties": {
        "k": { "$ref": "#/$defs/key" },
        "n": { "type": "string", "maxLength": 120 },
        "c": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "theme": { "enum": ["auto", "persepolis", "limestone", "obsidian", "lapis", "cedar", "porphyry", "light", "dark", "ocean", "rose", "sepia", "forest", "midnight", "amoled"] },
        "unit": { "enum": ["none", "toman", "rial", "custom", "تومان", "ریال"] },
        "ucustom": { "type": "string", "maxLength": 80 },
        "cal": { "enum": ["j", "g"] },
        "lang": { "enum": ["fa", "en"] },
        "budget": { "type": "number", "minimum": 0, "maximum": 1000000000000, "multipleOf": 0.01 },
        "cats": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/category" } }
      }
    }
  }
}
